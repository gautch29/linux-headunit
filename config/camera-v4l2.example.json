{
  "schemaVersion": 1,
  "enabled": false,
  "manualActivation": true,
  "streamIdentifier": "rear-camera",
  "source": {
    "kind": "v4l2",
    "device": "/dev/video0",
    "pixelFormat": "yuyv",
    "delivery": "dma-buf"
