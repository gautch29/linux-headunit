[Unit]
Description=Headunit HDMI output modes
Requires=headunit-compositor.service
After=headunit-compositor.service
PartOf=headunit-compositor.service

[Service]
Type=simple
User=@USER@
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
Environment=WAYLAND_DISPLAY=wayland-0
ExecStartPre=/usr/bin/python3 @REPO@/tools/wait_wayland.py --socket wayland-0
ExecStart=/usr/bin/kanshi -c @REPO@/config/kanshi-cm5-dual.conf
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
